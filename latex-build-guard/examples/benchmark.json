{
  "schema": "intro-style-benchmark/v1",
  "purpose": "写作13 LaTeX 写作与编译 公平对照案例：clean 验证不误报，defect 验证能检出。非平台正式案例/白板。",
  "work": "latex-build-guard",
  "four_questions": [
    "编译得通",
    "改得对",
    "交得可用",
    "复现得了"
  ],
  "cases": [
    {
      "case_id": "smoke",
      "type": "clean",
      "desc": "结构完整的正常输入，用于与缺陷案例对照展示；其中需人工确认的项属预期提示，不代表误报",
      "input": {
        "case_id": "smoke",
        "main_tex": "\\documentclass{article}\n\\usepackage{amsmath}\n\\usepackage{booktabs}\n\\begin{document}\n\\section{Intro}\nEquation \\eqref{eq:1}.\n\\begin{equation}\\label{eq:1}\nE = mc^2\n\\end{equation}\nCite \\cite{key2020}.\n\\end{document}\n",
        "bib": "@article{key2020, title={A}, author={X}, year={2020}}",
        "files": {
          "main.tex": "\\documentclass{article}\n\\usepackage{amsmath}\n\\usepackage{booktabs}\n\\begin{document}\n\\section{Intro}\nEquation \\eqref{eq:1}.\n\\begin{equation}\\label{eq:1}\nE = mc^2\n\\end{equation}\nCite \\cite{key2020}.\n\\end{document}\n",
          "refs.bib": "@article{key2020, title={A}, author={X}, year={2020}}"
        },
        "compile_log": "Output written on main.pdf (2 pages).",
        "build_record": "TeX Live 2023. 模板版本 v1.2 (.cls). 宏包 amsmath 2022. 字体 Times. 命令 pdflatex. 编译2轮."
      }
    },
    {
      "case_id": "smoke-DEFECT",
      "type": "defect",
      "desc": "按四问注入典型缺陷，Skill 应检出并标注",
      "input": {
        "case_id": "smoke-DEFECT",
        "main_tex": "\\documentclass{article}\n\\usepackage{amsmath}\n\\usepackage{booktabs}\n\\begin{document}\n\\section{Intro}\nEquation \\eqref{eq:1}.\n\\begin{equation}\\label{eq:1}\nE = mc^2\n\\end{equation}\nCite \\cite{key2020}.\n\\end{document}\n",
        "bib": "@article{key2020, title={A}, author={X}, year={2020}}",
        "files": {
          "main.tex": "\\documentclass{article}\n\\usepackage{amsmath}\n\\usepackage{booktabs}\n\\begin{document}\n\\section{Intro}\nEquation \\eqref{eq:1}.\n\\begin{equation}\\label{eq:1}\nE = mc^2\n\\end{equation}\nCite \\cite{key2020}.\n\\end{document}\n",
          "refs.bib": "@article{key2020, title={A}, author={X}, year={2020}}"
        },
        "compile_log": "! Undefined control sequence.\nl.12 \\unknowncmd\n! Missing $ inserted.\nl.20 x^2",
        "build_record": ""
      }
    }
  ],
  "completion_cases": [
    {
      "case_id": "latex-inline-full",
      "type": "end_to_end",
      "desc": "内联 main_tex+bib+files+compile_log：solve 应成稿并装配 result.json",
      "input_ref": "cases[0].input",
      "expect": {
        "delivery_written": true,
        "draft_nonempty": true
      }
    },
    {
      "case_id": "latex-real-no-log",
      "type": "end_to_end",
      "desc": "真实 .tex 文件、无 compile_log：编译状态标〔待编译验证〕、不臆造编译成功、诚实降级",
      "input": {
        "case_id": "real",
        "main_tex_file": "main.tex",
        "build_record": "TeX Live 2023. pdflatex. 编译2轮."
      },
      "companion_files": {
        "main.tex": "\\documentclass{article}\n\\begin{document}\nHello.\n\\end{document}\n"
      },
      "expect": {
        "adapter_read": true,
        "no_fabricated_compile": true,
        "delivery_written": true
      }
    },
    {
      "case_id": "latex-tex-file-adapter",
      "type": "adapter",
      "desc": "main_tex_file 读真实 .tex：适配器应读到 documentclass",
      "input": {
        "case_id": "files",
        "main_tex_file": "main.tex"
      },
      "companion_files": {
        "main.tex": "\\documentclass{article}\n\\begin{document}\nBody.\n\\end{document}\n"
      },
      "expect": {
        "main_tex_read": true
      }
    }
  ],
  "companion_note": "completion_cases 为端到端完成器/真实输入适配复现案例（非正式评测/白板）；cases 仍为四问机制对照的 clean+defect 两案。"
}