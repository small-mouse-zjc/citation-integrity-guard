  "completion_cases": [
    {
      "case_id": "note-inline-full",
      "type": "end_to_end",
      "desc": "内联 paper_sections+card+notes：solve 应逐章成稿并装配 result.json（delivery.written=true）",
      "input_ref": "cases[0].input",
      "expect": {
        "status": "ok",
        "chapters": 5,
        "card_fields": 6,
        "delivery_written": true
      }
    },
    {
      "case_id": "note-real-partial",
      "type": "end_to_end",
      "desc": "真实材料+notes_text，无 card：卡片字段标〔待补〕、不臆造、诚实降级 needs_attention",
      "input": {
        "case_id": "real",
        "paper_sections": [
          "摘要",
          "方法",
          "结果"
        ],
        "notes_text": "准确率0.90",
        "valid_anchors": [
